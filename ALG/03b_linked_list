merge two sorted linked list
```python
    def mergeTwoLists(self, list1: Optional[ListNode], list2: Optional[ListNode]) -> Optional[ListNode]:
        """iterative approach
        - more efficient (avoid function call)
        - more complicated index tracking
        """
        dummy = ListNode(-1)
        
        p = dummy # step (pointer/index) on result linked list, i
        p1 = list1 # step (pointer/index) on first linked list, j
        p2 = list2 # second, k

        while p1 is not None and p2 is not None:
            if p1.val > p2.val:
                p.next = p2 # res.append(list2[k])p
                p2 = p2.next # k += 1
            else:
                p.next = p1 # res.append(list1[j])
                p1 = p1.next # j += 1
            p = p.next # i += 1
        
        if p1:
            p.next = p1
        
        if p2:
            p.next = p2
        
        return dummy.next
```
```python
    def mergeTwoLists(self, list1: Optional[ListNode], list2: Optional[ListNode]) -> Optional[ListNode]:
        """recursive approach
        - more cost (function calls)
        - more straight forward and elegant
        """
        if list1 is None:
            return list2
        elif list2 is None:
            return list1
        else:
            if list1.val < list2.val:
                rest = self.mergeTwoLists(list1.next, list2)
                list1.next = rest
                return list1
            else:
                rest = self.mergeTwoLists(list1, list2.next)
                list2.next = rest
                return list2
