- if dummy node before head is used
```python
    def removeNthFromStart(self, head: Optional[ListNode], n: int) -> Optional[ListNode]:
        dummy = ListNode(-1)
        dummy.next = head

        prev = dummy
        curr = head

        while curr and n-1 > 0:
            prev = curr
            curr = curr.next
            n -= 1
        
        prev.next = curr.next
        return dummy.next # <- change here
```
Similarly, in addition to dummy head, we add dummy tail to doubly linked list, further avoiding cases when remove a list node.  

It's also helpful to use dummy node in concatenating lists, which saves us a case analysis on empty list
```python
    def partition(self, head: Optional[ListNode], x: int) -> Optional[ListNode]:
        dummy1 = ListNode(-1)
        dummy2 = ListNode(-1)

        p1, p2 = dummy1, dummy2 # pointers to list1 and list2
        p = head                # pointer to original list

        while p is not None:
            if p.val < x:
                p1.next = p
                p1 = p1.next
            else:
                p2.next = p
                p2 = p2.next
            p = p.next

        p1.next = dummy2.next
        p2.next = None

        return dummy1.next
```

### use two pointers coordinate with each other
usually a fast and a slow pointer
```python
    def removeNthFromEnd(self, head: Optional[ListNode], n: int) -> Optional[ListNode]:
        """
        two pointers move at different pace
        """
        p1 = head
        p1_cnt = 1

        dummy = ListNode(-1)
        dummy.next = head
        p2_prev = dummy
        p2 = head

        while p1_cnt <= n and p1:
            p1_cnt += 1
            p1 = p1.next
        
        while p1:
            p1 = p1.next

            p2_prev = p2
            p2 = p2.next
        
        p2_prev.next = p2.next

        return dummy.next
```
