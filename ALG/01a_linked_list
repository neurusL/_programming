    def deleteMiddle(self, head: Optional[ListNode]) -> Optional[ListNode]:
        p1 = head

        dummy = ListNode(-1)
        dummy.next = head
        p2_prev = dummy
        p2 = head

        while p1 and p1.next: # <- notice the guard here
            p1 = p1.next.next
            p2_prev = p2
            p2 = p2.next
        
        p2_prev.next = p2.next
        return dummy.next
```
